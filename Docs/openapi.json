{
  "openapi": "3.0.4",
  "info": {
    "title": "Identity & Presence API",
    "description": "This API provides identity management, presence tracking, and activity registration for people accessing controlled environments.",
    "contact": {
      "name": "Daniel Carrasco - CarrasDev",
      "url": "https://www.carrasdev.com",
      "email": "carrasdev@example.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/persons/{id}": {
      "get": {
        "tags": [
          "Persons"
        ],
        "summary": "Gets a person by their unique identifier.",
        "description": "Retrieves the details of a person using their unique identifier (GUID). Returns 200 if the person is found, or 404 if not found or not existing.",
        "operationId": "GetPersonById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Persons"
        ],
        "summary": "Updates an existing person.",
        "description": "Updates the details of an existing person. Returns 200 if the update is successful, 400 if there is a validation error, or 404 if the person is not found.",
        "operationId": "UpdatePerson",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePersonDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Persons"
        ],
        "summary": "Deletes an existing person.",
        "description": "Deletes an existing person. Returns 204 if the deletion is successful, or 404 if the person is not found.",
        "operationId": "DeletePerson",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/persons": {
      "post": {
        "tags": [
          "Persons"
        ],
        "summary": "Creates a new person.",
        "description": "Creates a new person with the provided details. Returns 201 if the person is successfully created,or 400 if there is a validation error.",
        "operationId": "CreatePerson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePersonDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "Persons"
        ],
        "summary": "Gets all persons.",
        "description": "Retrieves a list of all persons. Returns 200 if the list is successfully retrieved.",
        "operationId": "GetAllPersons",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/persons/code/{code}": {
      "get": {
        "tags": [
          "Persons"
        ],
        "summary": "Gets a person by code.",
        "description": "Gets a person by their unique code. Returns 200 if the person is found, or 404 if the person is not found.",
        "operationId": "GetPersonByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/visits": {
      "get": {
        "tags": [
          "Visits"
        ],
        "summary": "Get all visits",
        "description": "Retrieves a list of all visits from the system.",
        "operationId": "GetAllVisits",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/visits/entry": {
      "post": {
        "tags": [
          "Visits"
        ],
        "summary": "Register a new visit entry",
        "description": "Registers a new visit entry in the system (PersonId or Code).",
        "operationId": "RegisterEntry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterEntryDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/visits/active": {
      "get": {
        "tags": [
          "Visits"
        ],
        "summary": "Get all active visits",
        "description": "Retrieves a list of all active visits from the system and persons associated with them.",
        "operationId": "GetActiveVisits",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/visits/person/{personId}": {
      "get": {
        "tags": [
          "Visits"
        ],
        "summary": "Get visits by person",
        "description": "Retrieves a list of all visits associated with a specific person.",
        "operationId": "GetVisitsByPerson",
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/visits/exit": {
      "post": {
        "tags": [
          "Visits"
        ],
        "summary": "Register a visit exit",
        "description": "Registers the exit of a visit in the system (VisitId or Code).",
        "operationId": "RegisterExit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterExitDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePersonDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterEntryDto": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "entryTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterExitDto": {
        "type": "object",
        "properties": {
          "visitId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "exitTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdatePersonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Persons"
    },
    {
      "name": "Visits"
    }
  ]
}